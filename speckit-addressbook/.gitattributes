# https://github.com/gitattributes/gitattributes/blob/master/Java.gitattributes
#
# Normalize line endings to CRLF.
*               text eol=crlf

# Unix shell scripts must have LF.
gradlew         text eol=lf
mvnw            text eol=lf
*.{sh,[sS][hH]} text eol=lf

# Windows batch files must have CRLF.
*.{bat,[bB][aA][tT]} text eol=crlf
*.{cmd,[cC][mM][dD]} text eol=crlf

# Ensure that line endings for Windows batch files are not modified.
#*.bat -text
#*.cmd -text

*.java  text diff=java

# Exclude files from exporting
#.gitkeep   export-ignore

# Ensure the following are treated as binary.
# binary is a macro for '-text -diff'
*.exe   binary
*.gif   binary
*.jar   binary
*.jks   binary
*.jpeg  binary
*.jpg   binary
*.p12   binary
*.png   binary
*.pdf   binary
*.svg   text
*.ttf   binary
*.xlsm  binary
*.xlsx  binary
*.zip   binary
